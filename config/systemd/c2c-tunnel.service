# Outbound autossh reverse tunnel for maintenance. Deploy to /etc/systemd/system/.
# Requires /home/c2c/.ssh/id_tunnel (see docs/05-ssh-tunnel.md) and the
# TUNNEL_* variables in /etc/c2c/c2c.env.
[Unit]
Description=Comment2Conversation maintenance reverse SSH tunnel
After=network-online.target
Wants=network-online.target

[Service]
User=c2c
Group=c2c
EnvironmentFile=/etc/c2c/c2c.env
Environment=AUTOSSH_GATETIME=0
ExecStart=/usr/bin/autossh -M 0 -N \
    -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    -o StrictHostKeyChecking=accept-new \
    -i /home/c2c/.ssh/id_tunnel \
    -p ${TUNNEL_SSH_PORT} \
    -R ${TUNNEL_REMOTE_PORT}:localhost:22 \
    ${TUNNEL_USER}@${TUNNEL_HOST}
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
