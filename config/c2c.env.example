# Copy to /etc/c2c/c2c.env (root:c2c, mode 640). Not tracked in git.

# --- input API (c2c-server) ---
C2C_BIND=0.0.0.0
C2C_PORT=8080
C2C_DB=/var/lib/c2c/c2c.sqlite

# --- maintenance tunnel (c2c-tunnel) ---
TUNNEL_HOST=relay.example.org
TUNNEL_USER=c2ctunnel
TUNNEL_SSH_PORT=22
# Port opened on the relay's localhost that forwards back to the NUC's sshd:
TUNNEL_REMOTE_PORT=2222
